<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amcl_3d_core</name>
  <version>0.1.0</version>
  <description>ROS independent 3D Monte Carlo localization library (particle filter against a point cloud map)</description>
  <maintainer email="yukky.saito@gmail.com">Yukihiro Saito</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
